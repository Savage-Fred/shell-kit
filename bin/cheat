#!/usr/bin/env bash
# Stable entrypoint for existing shell/editor/tmux configurations during updates.
set -euo pipefail
runtime="$HOME/.local/share/shell-kit-runtime/bin/cheat"
if [ -x "$runtime" ]; then exec "$runtime" "$@"; fi
if [ -f "$HOME/.local/state/shell-kit/install.tsv" ]; then
    printf 'References are disabled. Run bash install.sh to enable them.\n' >&2
    exit 1
fi
root=$(cd "$(dirname "$0")/.." && pwd -P)
exec "$root/bin/cheat-enhanced" "$@"
