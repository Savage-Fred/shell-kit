#!/usr/bin/env python3
"""Literal search helpers; never evaluate shell definitions."""
import os
from pathlib import Path
import re
import subprocess
import sys

def definitions(text, query):
    chunks = re.split(r'(?=^(?:alias\s+)?[\w.-]+(?:=|\s*\(\))|^function\s+[\w.-]+)', text, flags=re.M)
    for chunk in chunks:
        match = re.match(r'(?:alias\s+|function\s+)?([\w.-]+)', chunk)
        if not match:
            continue
        name = match[1]
        if not query or (name.lower().startswith(query.lower()) if len(query) == 1 else query.lower() in chunk.lower()):
            yield name, chunk.rstrip()

def main():
    mode, *args = sys.argv[1:]
    if mode == 'aliases':
        for name, body in sorted(definitions(sys.stdin.read(), args[0] if args else '')):
            print(f'\n\033[1;36m{name}\033[0m\n{body}' if sys.stdout.isatty() else f'\n{name}\n{body}')
        return
    if mode == 'sfind' and 1 <= len(args) <= 2:
        root = str(Path(args[1] if len(args) > 1 else '.').resolve())
        sys.exit(subprocess.call(['rg', '--fixed-strings', '--line-number', '--with-filename', '--context', '1', '--color=auto', '--', args[0], root]))
    elif mode == 'dfind' and 1 <= len(args) <= 2:
        root = Path(args[1] if len(args) > 1 else '.').resolve()
        if not root.is_dir():
            raise ValueError('Not a directory: ' + str(root))
        for directory, dirs, _ in os.walk(root):
            dirs.sort()
            dirs[:] = [d for d in dirs if d != '.git']
            if args[0].casefold() in Path(directory).name.casefold():
                print(directory)
    elif mode == 'pfind' and len(args) == 2:
        emitting = False
        for number, line in enumerate(Path(args[1]).read_text().splitlines(), 1):
            if not line.strip():
                if emitting:
                    print()
                emitting = False
            elif args[0] in line or emitting:
                emitting = True
                if sys.stdout.isatty():
                    line = line.replace(args[0], '\033[1;31m' + args[0] + '\033[0m') if args[0] else line
                print(f'{number}: {line}')
    else:
        raise ValueError('Usage: sfind TEXT [DIR] | dfind PART [DIR] | pfind TEXT FILE')

if __name__ == '__main__':
    try:
        main()
    except (OSError, ValueError) as exc:
        print(str(exc), file=sys.stderr)
        sys.exit(2)
