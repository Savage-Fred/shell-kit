#!/usr/bin/env python3
"""A roomy native fzf session chooser; cancellation does nothing."""
import os
import subprocess as sp
import sys

result = sp.run(['tmux', 'list-sessions', '-F', '#{session_id}\t#{session_name}\t#{session_windows} windows\t#{?session_attached,ATTACHED,detached}'], text=True, capture_output=True)
if result.returncode:
    print('No sessions yet. Create one with: tn NAME')
    sys.exit(0)
try:
    chosen = sp.run(['fzf', '--height=80%', '--layout=reverse', '--border', '--delimiter=\t', '--with-nth=2..', '--prompt=Session > ', '--header=Enter: attach / switch     Esc: cancel     Create: tn NAME', '--preview', 'tmux list-windows -t {1} -F "#{window_index}: #{window_name}   (#{window_panes} panes)"', '--preview-window=down:45%:wrap'], input=result.stdout, text=True, stdout=sp.PIPE)
except FileNotFoundError:
    print('Install fzf for the session picker. Sessions:\n' + result.stdout)
    sys.exit(1)
if chosen.returncode == 0:
    target = chosen.stdout.split('\t')[0]
    os.execvp('tmux', ['tmux', 'switch-client' if os.environ.get('TMUX') else 'attach-session', '-t', target])
