#!/usr/bin/env bash
# Use tmux's existing session chooser instead of requiring fzf.
set -euo pipefail
if ! tmux list-sessions >/dev/null 2>&1; then
    printf 'No sessions yet. Create one with: tn NAME\n'
elif [ -n "${TMUX-}" ]; then
    exec tmux choose-tree -s
else
    exec tmux attach-session \; choose-tree -s
fi
