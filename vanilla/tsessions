#!/usr/bin/env bash
# Find and attach tmux sessions by name, running command, or working directory.
# Usable from a shell alias or directly: ssh HOST -t tsessions attach work
set -u

register_client() {
    [ -z "${TMUX-}" ] && [ -t 0 ] || return 0
    local cheat="$HOME/.local/share/shell-kit-runtime/bin/cheat"
    [ -x "$cheat" ] && "$cheat" register >/dev/null 2>&1 || true
}

USAGE="usage: tsessions [list|attach|which] [PATTERN]"

fields=$'#{session_name}\t#{session_attached}\t#{session_windows}\t#{session_activity}\t#{pane_current_command}\t#{pane_current_path}\t#{window_active}\t#{pane_active}\t#{@shell_kit}'

select_rows() {
    # Tier 1 exact name, tier 2 name prefix, tier 3 name/command/path substring
    # across any work pane in the session (skipping helper panes for display).
    tmux -u list-panes -a -F "$fields" 2>/dev/null | SK_PATTERN=$1 awk -F'\t' '
        BEGIN { pat = tolower(ENVIRON["SK_PATTERN"]) }
        {
            s = $1
            if (!seen[s]++) order[++n] = s
            att[s] = $2; win[s] = $3; act[s] = $4
            is_help = ($9 != "")
            is_act = ($7 == "1" && $8 == "1")
            is_busy = (!is_help && $5 !~ /^(bash|zsh|sh|fish|-bash|-zsh)$/)
            p = is_help ? 1 : (is_act && is_busy ? 5 : (is_busy ? 4 : (is_act ? 3 : 2)))
            if (p > prio[s]) { prio[s] = p; cmd[s] = $5; path[s] = $6 }
            if (pat != "" && !is_help && (index(tolower($5), pat) || index(tolower($6), pat))) {
                hit[s] = 1
                if (p >= hit_prio[s]) { hit_prio[s] = p; hit_cmd[s] = $5; hit_path[s] = $6 }
            }
        }
        END {
            for (i = 1; i <= n; i++) {
                s = order[i]; ls = tolower(s)
                c = cmd[s]; d = path[s]
                if (pat == "") tier = 3
                else if (ls == pat) tier = 1
                else if (index(ls, pat) == 1) tier = 2
                else if (index(ls, pat)) tier = 3
                else if (hit[s]) { tier = 3; c = hit_cmd[s]; d = hit_path[s] }
                else if (index(tolower(c), pat) || index(tolower(d), pat)) tier = 3
                else continue
                printf "%d\t%s\t%s\t%s\t%s\t%s\t%s\n", tier, s, att[s], win[s], act[s], c, d
            }
        }'
}

render() {
    awk -F'\t' -v home="${HOME:-}" -v now="$(date +%s)" '
        function idle(then,   s) {
            s = now - then
            if (then == "" || s < 0) return "-"
            if (s < 3600) return int(s / 60) "m"
            if (s < 86400) return int(s / 3600) "h"
            return int(s / 86400) "d"
        }
        function shorten(p) {
            if (home == "") return p
            if (p == home) return "~"
            if (index(p, home "/") == 1) return "~" substr(p, length(home) + 1)
            return p
        }
        function pad(s, w) {
            while (length(s) < w) s = s " "
            return s
        }
        BEGIN { w2 = 7; w6 = 7 }
        {
            rows[++n] = $0
            if (length($2) > w2) w2 = length($2) > 14 ? 14 : length($2)
            if (length($6) > w6) w6 = length($6) > 12 ? 12 : length($6)
        }
        END {
            printf "  %s %3s %4s  %s %s\n", pad("SESSION", w2), "WIN", "IDLE", pad("RUNNING", w6), "PATH"
            for (i = 1; i <= n; i++) {
                split(rows[i], f, "\t")
                printf "%s %s %3s %4s  %s %s\n", (f[3] + 0 > 0 ? "*" : " "), pad(f[2], w2), f[4], idle(f[5]), pad(f[6], w6), shorten(f[7])
            }
        }'
}

# Print the single session a pattern identifies, or explain why it does not.
resolve() {
    local rows best matched
    rows=$(select_rows "$1")
    if [ -z "$rows" ]; then
        printf 'No session matches: %s\n' "$1" >&2
        select_rows '' | render >&2
        return 1
    fi
    best=$(printf '%s\n' "$rows" | cut -f1 | sort -n | head -1)
    matched=$(printf '%s\n' "$rows" | awk -F'\t' -v t="$best" '$1 == t')
    if [ "$(printf '%s\n' "$matched" | wc -l)" -gt 1 ]; then
        printf 'Several sessions match "%s"; name one:\n' "$1" >&2
        printf '%s\n' "$matched" | render >&2
        return 1
    fi
    printf '%s\n' "$matched" | cut -f2
}

action=${1-list}
case $action in
    list|attach|which) shift ;;
    -h|--help) printf '%s\n' "$USAGE"; exit 0 ;;
    *) action=list ;;
esac
pattern=${1-}
case $pattern in
    -h|--help) printf '%s\n' "$USAGE"; exit 0 ;;
esac

tmux list-sessions >/dev/null 2>&1 || {
    printf 'No sessions yet. Create one with: tn NAME\n' >&2
    exit 1
}

case $action in
    list)
        rows=$(select_rows "$pattern")
        if [ -z "$rows" ]; then resolve "$pattern"; exit 1; fi
        printf '%s\n' "$rows" | sort -t"$(printf '\t')" -k1,1n | render
        ;;
    which)
        resolve "$pattern"
        ;;
    attach)
        if [ -z "$pattern" ]; then
            # tmux already tracks the most recent session; let it choose.
            if [ -z "${TMUX-}" ]; then register_client; exec tmux attach-session; fi
            tmux switch-client -l 2>/dev/null && exit 0
            printf 'No previous session to return to; name one:\n' >&2
            select_rows '' | render >&2
            exit 1
        fi
        case $pattern in
            # A colon names a window (tmux target syntax); keep the session exact.
            :*) target=$pattern ;;
            *:*) target="=$pattern" ;;
            *) name=$(resolve "$pattern") || exit 1; target="=$name" ;;
        esac
        if [ -n "${TMUX-}" ]; then exec tmux switch-client -t "$target"; else register_client; exec tmux attach-session -t "$target"; fi
        ;;
esac
