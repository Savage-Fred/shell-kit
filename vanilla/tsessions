#!/usr/bin/env bash
# Find and attach tmux sessions by name, running command, or working directory.
# Usable from a shell alias or directly: ssh HOST -t tsessions attach studio
set -u

fields=$'#{session_name}\t#{session_attached}\t#{session_windows}\t#{session_activity}\t#{pane_current_command}\t#{pane_current_path}'

select_rows() {
    # Tier 1 exact name, tier 2 name prefix, tier 3 name/command/path substring.
    tmux list-sessions -F "$fields" 2>/dev/null | awk -F'\t' -v pat="$1" '
        BEGIN { pat = tolower(pat) }
        {
            if (pat == "") tier = 3
            else if (tolower($1) == pat) tier = 1
            else if (index(tolower($1), pat) == 1) tier = 2
            else if (index(tolower($1), pat) || index(tolower($5), pat) || index(tolower($6), pat)) tier = 3
            else next
            print tier "\t" $0
        }'
}

render() {
    awk -F'\t' -v home="$HOME" -v now="$(date +%s)" '
        function idle(then,   s) {
            s = now - then
            if (then == "" || s < 0) return "-"
            if (s < 3600) return int(s / 60) "m"
            if (s < 86400) return int(s / 3600) "h"
            return int(s / 86400) "d"
        }
        function shorten(p) {
            if (home != "" && index(p, home) == 1) return "~" substr(p, length(home) + 1)
            return p
        }
        BEGIN { printf "  %-14s %3s %6s  %-12s %s\n", "SESSION", "WIN", "IDLE", "RUNNING", "PATH" }
        { printf "%s %-14s %3s %6s  %-12s %s\n", ($3 == "1" ? "*" : " "), $2, $4, idle($5), $6, shorten($7) }'
}

# Print the single session a pattern identifies, or explain why it does not.
resolve() {
    local rows best matched
    rows=$(select_rows "$1")
    if [ -z "$rows" ]; then
        printf 'No session matches: %s\n' "$1" >&2
        select_rows '' | render >&2
        return 1
    fi
    best=$(printf '%s\n' "$rows" | cut -f1 | sort -n | head -1)
    matched=$(printf '%s\n' "$rows" | awk -F'\t' -v t="$best" '$1 == t')
    if [ "$(printf '%s\n' "$matched" | wc -l)" -gt 1 ]; then
        printf 'Several sessions match "%s"; name one:\n' "$1" >&2
        printf '%s\n' "$matched" | render >&2
        return 1
    fi
    printf '%s\n' "$matched" | cut -f2
}

action=${1-list}
case $action in
    list|attach|which) shift ;;
    -h|--help) printf 'usage: tsessions [list|attach|which] [PATTERN]\n'; exit 0 ;;
    *) action=list ;;
esac
pattern=${1-}

tmux list-sessions >/dev/null 2>&1 || {
    printf 'No sessions yet. Create one with: tn NAME\n' >&2
    exit 1
}

case $action in
    list)
        rows=$(select_rows "$pattern")
        if [ -z "$rows" ]; then resolve "$pattern"; exit 1; fi
        printf '%s\n' "$rows" | sort -t"$(printf '\t')" -k1,1n | render
        ;;
    which)
        resolve "$pattern"
        ;;
    attach)
        if [ -z "$pattern" ]; then
            # tmux already tracks the most recent session; let it choose.
            if [ -n "${TMUX-}" ]; then exec tmux switch-client -l; else exec tmux attach-session; fi
        fi
        name=$(resolve "$pattern") || exit 1
        if [ -n "${TMUX-}" ]; then exec tmux switch-client -t "$name"; else exec tmux attach-session -t "$name"; fi
        ;;
esac
