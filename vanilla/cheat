#!/usr/bin/env bash
# Plain references: no Python, rendering library, or automatic layout changes.
set -euo pipefail
ROOT="$HOME/.local/share/shell-kit"
if [ ! -d "$ROOT/sheets" ]; then
    SELF=${BASH_SOURCE[0]:-$0}
    while [ -L "$SELF" ]; do
        target=$(readlink "$SELF")
        case $target in /*) SELF=$target ;; *) SELF=$(dirname "$SELF")/$target ;; esac
    done
    ROOT=$(cd -P -- "$(dirname "$SELF")/.." && pwd)
fi
if [ -z "${1:-}" ]; then
    if command -v fzf >/dev/null 2>&1 && [ -t 0 ] && [ -t 1 ]; then
        sheets_list=$(for f in "$ROOT"/sheets/*.md; do [ -e "$f" ] || continue; n=${f##*/}; printf '%s\n' "${n%.md}"; done)
        selected=$(printf '%s\n' "$sheets_list" | fzf --prompt='Sheet > ' --preview="cat \"$ROOT/sheets/{}.md\"" --preview-window='down:60%:wrap' || true)
        if [ -n "$selected" ]; then
            exec "$0" view "$selected"
        fi
        exit 0
    fi
    action=list
else
    action=$1
fi
case $action in
    list) printf 'Sheets:'; for file in "$ROOT"/sheets/*.md; do name=${file##*/}; printf ' %s' "${name%.md}"; done; printf '\n'; exit ;;
    profile) printf 'phone\n'; exit ;; # Manual help only in vanilla mode.
    register|attach|cleanup|close-owner|close|auto) exit 0 ;;
    auto-enabled) exit 1 ;;
    view|open|edit) topic=${2:?Supply a reference name} ;;
    *) topic=$action ;;
esac
case $topic in ''|*[!a-zA-Z0-9_-]*) printf 'Invalid reference name\n' >&2; exit 1;; esac
file="$ROOT/sheets/$topic.md"
[ -f "$file" ] || { printf 'Unknown reference: %s\n' "$topic" >&2; exit 1; }
if [ "$action" = edit ]; then
    # EDITOR is an executable name/path. Flags belong in an editor wrapper.
    exec "${EDITOR:-vi}" "$file"
elif [ -n "${TMUX-}" ] && [ "$action" != view ] && command -v less >/dev/null 2>&1; then
    # printf %q produces Bash quoting; invoke Bash explicitly, even under Zsh.
    printf -v command 'exec bash %q view %q' "$HOME/.local/share/shell-kit-runtime/bin/cheat" "$topic"
    exec tmux display-popup -E -w 80% -h 80% "$command"
elif command -v less >/dev/null 2>&1 && [ -t 1 ]; then
    unset LESS LESSOPEN
    export LESSHISTFILE=- LESSKEY="$ROOT/integrations/less.keys"
    exec less -R -i -+F -+X +g -P 'Sheila | q/F1-F6 close | arrows scroll | / search' "$file"
else
    BAT_CMD=$(command -v bat || command -v batcat || true)
    if [ -n "$BAT_CMD" ] && [ -t 1 ]; then
        "$BAT_CMD" --plain "$file" 2>/dev/null && exit 0 || :
    fi
    cat "$file"
fi
